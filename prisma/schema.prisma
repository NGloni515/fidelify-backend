generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explicit: left to auto-detection it depends on tsconfig.json being present
  // at install time, and without it the client imports ".ts" files that do not
  // exist once compiled.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Businesses and staff ----------

model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // printed on the counter QR: /join/:slug
  logoUrl   String?
  colors    Json? // { background, foreground, label }
  plan      Plan     @default(BASIC)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  staff         StaffUser[]
  programs      Program[]
  customers     Customer[]
  coupons       Coupon[]
  notifications Notification[]
}

enum Plan {
  BASIC
  PRO
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        StaffUser[]
  transactions Transaction[]

  @@index([businessId])
}

model StaffUser {
  id           String    @id @default(uuid())
  businessId   String
  branchId     String?
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(CASHIER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([businessId])
}

enum StaffRole {
  OWNER
  CASHIER
}

// ---------- Loyalty program ----------

model Program {
  id             String      @id @default(uuid())
  businessId     String
  name           String
  type           ProgramType @default(STAMPS)
  stampsRequired Int         @default(8)
  rewardText     String // "1 helado gratis"
  design         Json? // no defined shape yet
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  passes   Pass[]

  @@index([businessId])
}

enum ProgramType {
  STAMPS
  POINTS
}

// ---------- Customers and passes ----------

model Customer {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  phone       String
  email       String?
  birthDate   DateTime? @db.Date
  consentAt   DateTime // consent evidence required by Ecuador's LOPDP
  consentText String
  createdAt   DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  passes   Pass[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Pass {
  id           String     @id @default(uuid())
  programId    String
  customerId   String
  serialNumber String     @unique // encoded in the pass QR
  authToken    String // Apple Wallet web service secret; never returned
  platform     Platform?
  balance      Int        @default(0) // stamps towards the next reward
  rewardsReady Int        @default(0) // earned and not yet redeemed
  status       PassStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  program            Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  appleRegistrations AppleDeviceRegistration[]
  googleObjectId     String?                   @unique

  @@unique([programId, customerId])
}

enum Platform {
  APPLE
  GOOGLE
}

enum PassStatus {
  ACTIVE
  VOIDED
}

// Source of truth: a pass balance can be rebuilt from these rows.
model Transaction {
  id        String          @id @default(uuid())
  passId    String
  staffId   String?
  branchId  String?
  type      TransactionType
  amount    Int // stamps given; -1 per redeemed reward
  note      String?
  createdAt DateTime        @default(now())

  pass   Pass       @relation(fields: [passId], references: [id], onDelete: Cascade)
  staff  StaffUser? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  branch Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([passId, createdAt])
}

enum TransactionType {
  STAMP
  REDEEM
  ADJUST
}

// ---------- Coupons ----------

model Coupon {
  id         String   @id @default(uuid())
  businessId String
  title      String // "2x1 en conos"
  details    String?
  startsAt   DateTime
  expiresAt  DateTime
  maxUses    Int? // null = unlimited
  createdAt  DateTime @default(now())

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@index([businessId])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  customerId String?
  staffId    String?
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
}

// ---------- Apple Wallet: devices registered for updates ----------

model AppleDeviceRegistration {
  id                 String   @id @default(uuid())
  deviceLibraryId    String
  pushToken          String
  passTypeIdentifier String
  passId             String
  createdAt          DateTime @default(now())

  pass Pass @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@unique([deviceLibraryId, passTypeIdentifier, passId])
}

// ---------- Sent notifications ----------

model Notification {
  id         String   @id @default(uuid())
  businessId String
  message    String
  segment    String? // "all", "inactive", ...
  sentCount  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
