DATABASE_URL="postgresql://fidelify:fidelify@localhost:5432/fidelify?schema=public"
# Host port of the Docker Postgres. Change it here and in DATABASE_URL when 5432 is taken.
DB_PORT=5432
PORT=3000
# Backoffice (5173) y web pública (5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_WEB_URL=http://localhost:5174

# Staff session. Production needs long random values: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Owner and cashier created by the development seed
SEED_OWNER_EMAIL=dueno@heladeria-demo.test
SEED_CASHIER_EMAIL=caja@heladeria-demo.test
SEED_STAFF_PASSWORD=heladeria-demo-2026

# Wallet. Without these the wallet routes answer 501 and everything else works.
# Each secret takes a file path, the value itself, or its base64.
# PUBLIC_API_URL=https://api.example.com
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT=secrets/google/service-account.json
# APPLE_PASS_TYPE_ID=
# APPLE_TEAM_ID=
# APPLE_PASS_CERT=secrets/apple/pass.pem
# APPLE_PASS_KEY=secrets/apple/pass.key
# APPLE_WWDR_CERT=secrets/apple/wwdr.pem
